# Optional local-only overrides. Copy to `.env.local` (gitignored) if you want
# names baked in during development.
#
# You do NOT need this file. The preferred route is to set the names once on the
# device itself (Lab -> Settings). Names entered there live only in that
# tablet's IndexedDB and never touch the repo, this file, or any build output.
VITE_KID_NAME=
VITE_PAPA_NAME=
